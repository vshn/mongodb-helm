# chartsnap: snapshot_version=v3
---
# Source: mongodb/templates/pdb.yaml
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: mongodb
  namespace: "mongodb"
  labels:
    k8ify.service: mongodb
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      k8ify.service: mongodb
  unhealthyPodEvictionPolicy: IfHealthyBudget
---
# Source: mongodb/templates/service-account.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: test-mongodb
  namespace: "mongodb"
  labels:
    helm.sh/chart: '###DYNAMIC_FIELD###'
    app.kubernetes.io/version: '###DYNAMIC_FIELD###'
---
# Source: mongodb/templates/service-mongodb.yaml
kind: Service
apiVersion: v1
metadata:
  name: mongodb-0
  namespace: "mongodb"
  labels:
    k8ify.service: mongodb
    helm.sh/chart: '###DYNAMIC_FIELD###'
    app.kubernetes.io/version: '###DYNAMIC_FIELD###'
spec:
  clusterIP: None
  ports:
  - name: '27017'
    protocol: TCP
    port: 27017
    targetPort: 27017
  selector:
    k8ify.service: mongodb
    statefulset.kubernetes.io/pod-name: mongodb-0
---
