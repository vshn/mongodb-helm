metadata:
  name: mongodb-2
  namespace: "mongodb"
  labels:
    k8ify.service: mongodb
    helm.sh/chart: '###DYNAMIC_FIELD###'
    app.kubernetes.io/version: '###DYNAMIC_FIELD###'
spec:
  clusterIP: None
  ports:
  - name: '27017'
