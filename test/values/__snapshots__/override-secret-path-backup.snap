# Source: mongodb/templates/backup/objectbucket.yaml
apiVersion: appcat.vshn.io/v1
kind: ObjectBucket
metadata:
  name: backup-objectbucket
  namespace: "mongodb"
  annotations:
    "helm.sh/resource-policy": keep
spec:
  parameters:
    region: rma
    security:
      deletionProtection: true
  writeConnectionSecretToRef:
    name: k8up-repo
---
# Source: mongodb/templates/podmonitor.yaml
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: mongodb
  namespace: "mongodb"
  labels:
    k8ify.service: mongodb
spec:
  namespaceSelector:
    matchNames:
    - "mongodb"
  selector:
    matchLabels:
      k8ify.service: mongodb
  podMetricsEndpoints:
  - port: metrics
    path: /metrics
    interval: 60s
    scrapeTimeout: 30s
---
# Source: mongodb/templates/backup/schedule.yaml
apiVersion: k8up.io/v1
kind: Schedule
metadata:
  name: backup-schedule
  namespace: "mongodb"
spec:
  backup:
    schedule: "5 4 * * *"
    failedJobsHistoryLimit: 1
    successfulJobsHistoryLimit: 1
  check:
    schedule: "5 6 * * *"
    failedJobsHistoryLimit: 1
    successfulJobsHistoryLimit: 1
  prune:
    schedule: "5 7 * * *"
    retention:
      keepDaily: 7
      keepWeekly: 2
      keepMonthly: 2
    failedJobsHistoryLimit: 1
    successfulJobsHistoryLimit: 1
  backend:
    repoPasswordSecretRef:
      key: password
      name: backup-encryption
    s3:
      endpointSecretKey: ENDPOINT
      bucketSecretKey: BUCKET_NAME
      accessKeyIDSecretRef:
        name: k8up-repo
        key: AWS_ACCESS_KEY_ID
      secretAccessKeySecretRef:
        name: k8up-repo
        key: AWS_SECRET_ACCESS_KEY
---
# Source: mongodb/templates/secretstore.yaml
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: mongodb-store
  namespace: "mongodb"
spec:
  provider:
    vault:
      server: "http://openbao.openbao.svc.cluster.local:8200"
      path: "secret"
      version: "v2"
      auth:
        kubernetes:
          mountPath: "kubernetes"
          role: "mongodb-test-reader"
          serviceAccountRef:
            name: "test-mongodb"
            namespace: "mongodb"
