# Source: mongodb/templates/statefulset-mongodb.yaml
apiVersion: apps/v1
kind: StatefulSet
metadata:
  creationTimestamp: null
  name: mongodb
  namespace: "mongodb"
  labels:
    k8ify.service: mongodb
    helm.sh/chart: '###DYNAMIC_FIELD###'
    app.kubernetes.io/version: '###DYNAMIC_FIELD###'
spec:
  selector:
    matchLabels:
      k8ify.service: mongodb
  serviceName: mongodb
  template:
    metadata:
      creationTimestamp: null
      labels:
        k8ify.service: mongodb
        helm.sh/chart: '###DYNAMIC_FIELD###'
        app.kubernetes.io/version: '###DYNAMIC_FIELD###'
      annotations:
        k8up.io/backupcommand: "sh -c 'mongodump --archive \"mongodb://$MONGODB_ROOT_USER:$MONGODB_ROOT_PASSWORD@mongodb-0.mongodb.svc.cluster.local,mongodb-1.mongodb.svc.cluster.local,mongodb-2.mongodb.svc.cluster.local/admin\"'"
        k8up.io/file-extension: .archive
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  k8ify.service: mongodb
              topologyKey: kubernetes.io/hostname
      containers:
      - envFrom:
        - secretRef:
            name: mongodb-env
        image: "###DYNAMIC_FIELD###"
        command:
        - '/bin/bash'
        - '-c'
        - 'echo "${MONGODB_REPLICA_SET_KEY}" > /tmp/mongod.key; chmod 400 /tmp/mongod.key; /usr/local/bin/docker-entrypoint.sh --auth --replSet "${MONGODB_REPLICA_SET_NAME}" --keyFile /tmp/mongod.key'
        livenessProbe:
          exec:
            command:
            - /bin/sh
            - '-c'
            - |
              mongosh "mongodb://${MONGODB_ROOT_USER}:${MONGODB_ROOT_PASSWORD}@localhost:27017/admin" \
              --eval \
              "db.adminCommand('ping')" \
              --quiet
          failureThreshold: 6
          initialDelaySeconds: 30
          periodSeconds: 20
          successThreshold: 1
          timeoutSeconds: 10
        name: mongodb
        ports:
        - containerPort: 27017
          protocol: TCP
        resources:
          limits:
            cpu: "1"
            memory: "1Gi"
          requests:
            cpu: "50m"
            memory: "1Gi"
        readinessProbe:
          exec:
            command:
            - /bin/sh
            - '-c'
            - |
              mongosh "mongodb://${MONGODB_ROOT_USER}:${MONGODB_ROOT_PASSWORD}@localhost:27017/admin" \
              --eval \
              "db.adminCommand('ping')" \
              --quiet
          failureThreshold: 6
          initialDelaySeconds: 5
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        startupProbe:
          exec:
            command:
            - /bin/sh
            - '-c'
            - |
              mongosh "mongodb://${MONGODB_ROOT_USER}:${MONGODB_ROOT_PASSWORD}@localhost:27017/admin" \
              --eval \
              "db.adminCommand('ping')" \
              --quiet
          failureThreshold: 30
          initialDelaySeconds: 5
          periodSeconds: 20
          successThreshold: 1
          timeoutSeconds: 10
        volumeMounts:
        - name: mongodb-data
          mountPath: /data/db
          subPath: data/db
      - name: mongodb-exporter
        image: "###DYNAMIC_FIELD###"
        imagePullPolicy: IfNotPresent
        args:
        - --collector.dbstats
        - --collector.topmetrics
        - --collector.replicasetstatus
        - --discovering-mode
        - --log.level=warn
        - --mongodb.global-conn-pool
        env:
        - name: MONGODB_URI
          value: "mongodb://$(MONGODB_ROOT_USER):$(MONGODB_ROOT_PASSWORD)@127.0.0.1:27017/admin"
        envFrom:
        - secretRef:
            name: mongodb-env
        ports:
        - name: metrics
          containerPort: 9216
          protocol: TCP
        livenessProbe:
          tcpSocket:
            port: metrics
          initialDelaySeconds: 15
          timeoutSeconds: 10
          periodSeconds: 20
          failureThreshold: 6
          successThreshold: 1
        readinessProbe:
          tcpSocket:
            port: metrics
          initialDelaySeconds: 5
          timeoutSeconds: 10
          periodSeconds: 10
          failureThreshold: 6
          successThreshold: 1
        startupProbe:
          tcpSocket:
            port: metrics
          failureThreshold: 30
          initialDelaySeconds: 5
          periodSeconds: 20
          successThreshold: 1
          timeoutSeconds: 10
        resources:
          limits:
            cpu: "200m"
            memory: "128Mi"
          requests:
            cpu: "50m"
            memory: "64Mi"
      initContainers: []
  updateStrategy: {}
  replicas: 3
  volumeClaimTemplates:
  - kind: PersistentVolumeClaim
    apiVersion: v1
    metadata:
      name: mongodb-data
      creationTimestamp: null
      annotations:
        k8up.io/backup: "false"
      labels:
        k8ify.service: mongodb
    spec:
      accessModes:
      - ReadWriteOnce
      resources:
        requests:
          storage: 5Gi
      storageClassName: ssd-encrypted
      volumeMode: Filesystem
---
# Source: mongodb/templates/backup/backup-encryption-externalsecret.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: backup-encryption
  namespace: "mongodb"
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: mongodb-store
    kind: SecretStore
  target:
    name: backup-encryption
    template:
      data:
        password: "{{ .backupEncryptionSecret }}"
  dataFrom:
  - extract:
      key: backups/mongo
---
# Source: mongodb/templates/externalsecrets.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: mongodb-env
  namespace: "mongodb"
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: mongodb-store
    kind: SecretStore
  target:
    name: mongodb-env
    template:
      metadata:
        labels:
          k8ify.service: mongodb
      data:
        MONGO_INITDB_ROOT_USERNAME: "root"
        MONGO_INITDB_ROOT_PASSWORD: "{{ .rootPassword }}"
        MONGODB_ROOT_USER: "root"
        MONGODB_ROOT_PASSWORD: "{{ .rootPassword }}"
        MONGODB_REPLICA_SET_NAME: "test"
        MONGODB_REPLICA_SET_KEY: "{{ .replicaSetKey }}"
  dataFrom:
  - extract:
      key: backups/mongo
---
# Source: mongodb/templates/externalsecrets.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: mongodb-data-mongodb-0-luks-key
  namespace: "mongodb"
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: mongodb-store
    kind: SecretStore
  target:
    name: mongodb-data-mongodb-0-luks-key
    template:
      metadata:
        labels:
          k8ify.service: mongodb
      data:
        luksKey: "{{ .luksKey }}"
  dataFrom:
  - extract:
      key: backups/mongo
---
